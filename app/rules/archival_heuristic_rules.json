{
  "cnj": {
    "pattern": "\\b\\d{7}-\\d{2}\\.\\d{4}\\.\\d{1}\\.\\d{2}\\.\\d{4}\\b",
    "type": "cnj",
    "description": "Número CNJ"
  },
  "arquivamento_direto": {
    "pattern": "(?i)\\barquiv(?:e-se|em-se|amento)\\b",
    "type": "basic",
    "score": 2.2,
    "description": "Arquivamento explícito (arquive-se/arquivamento)"
  },
  "baixa_distribuicao": {
    "pattern": "(?i)\\bbaixa\\s+na\\s+distribu(?:i|í)\\u00e7(?:a|ã)o\\b",
    "type": "basic",
    "score": 1.6,
    "description": "Baixa na distribuição"
  },
  "conclusos_arquivamento": {
    "pattern": "(?i)\\bconclus(?:o|\\u00f5)s\\s+(?:para|ao)\\s+arquiv(?:o|amento)\\b",
    "type": "basic",
    "score": 1.2,
    "description": "Conclusos para arquivamento"
  },
  "extincao_processo": {
    "pattern": "(?i)\\bextin\\u00e7(?:a|ã)o\\s+do\\s+processo\\b",
    "type": "basic",
    "score": 1.5,
    "description": "Extinção do processo"
  },
  "transito_em_julgado_perto_arquiv": {
    "pattern": "(?i)\\btr\\u00e2nsito\\s+em\\s+julgado\\b[\\s\\S]{0,120}?\\barquiv\\w*\\b",
    "type": "proximity",
    "score": 1.8,
    "description": "Trânsito em julgado próximo de arquivamento (até ~120 chars)"
  },
  "sentenca_arquivamento": {
    "pattern": "(?i)\\bsenten\\u00e7a\\b[\\s\\S]{0,140}?\\barquiv\\w*\\b",
    "type": "proximity",
    "score": 1.4,
    "description": "Sentença referindo-se a arquivamento"
  },
  "thresholds": {
    "forte": 0.9,
    "provavel": 0.6
  }
