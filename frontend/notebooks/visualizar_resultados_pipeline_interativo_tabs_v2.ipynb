   "source": [
    "# 📊 Visualização Interativa das Tabelas do Pipeline SJUR"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sqlite3
",
    "import pandas as pd
",
    "import ipywidgets as widgets
",
    "from IPython.display import display, HTML
",
    "from app.database.db_connection import get_connection
",
    "
",
    "def carregar_tabela(nome_tabela):
",
    "    conn = get_connection()
",
    "    try:
",
    "        df = pd.read_sql_query(f"SELECT * FROM {nome_tabela}", conn)
",
    "    except Exception as e:
",
    "        df = pd.DataFrame({"Erro": [str(e)]})
",
    "    finally:
",
    "        conn.close()
",
    "    return df
",
    "
",
    "def criar_tabela_interativa(df):
",
    "    linhas_por_pagina = 10
",
    "    total_linhas = len(df)
",
    "    paginas = (total_linhas - 1) // linhas_por_pagina + 1
",
    "
",
    "    dropdown = widgets.Dropdown(
",
    "        options=[(f"Página {i+1}", i) for i in range(paginas)],
",
    "        description="Página:"
",
    "    )
",
    "
",
    "    output = widgets.Output()
",
    "
",
    "    def atualizar_tabela(change):
",
    "        output.clear_output()
",
    "        with output:
",
    "            inicio = change.new * linhas_por_pagina
",
    "            fim = inicio + linhas_por_pagina
",
    "            display(df.iloc[inicio:fim])
",
    "
",
    "    dropdown.observe(atualizar_tabela, names="value")
",
    "    atualizar_tabela(widgets.interactive_output(lambda value: None, {"value": dropdown}))
",
    "
",
    "    display(dropdown)
",
    "    display(output)
",
    "
",
    "abas = widgets.Tab()
",
    "nomes_tabelas = ["emails_processados", "publicacoes", "partes", "metadados"]
",
    "conteudo_abas = []
",
    "for nome in nomes_tabelas:
",
    "    df = carregar_tabela(nome)
",
    "    out = widgets.Output()
",
    "    with out:
",
    "        display(HTML(f"<h4>📂 Tabela: {nome}</h4>"))
",
    "        criar_tabela_interativa(df)
",
    "    conteudo_abas.append(out)
",
    "
",
    "abas.children = conteudo_abas
",
    "for i, nome in enumerate(nomes_tabelas):
",
    "    abas.set_title(i, nome)
",
    "display(abas)"
   ]
  }
 ],
